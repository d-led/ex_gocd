<div class="job-details-page px-8 py-8 bg-[#f4f8f9] min-h-screen font-sans">
  <!-- Breadcrumb Header -->
  <div class="page-header border-b border-gray-200 pb-4 mb-6">
    <div class="flex items-center gap-2 text-xs text-gray-500 font-mono font-bold uppercase tracking-wider">
      <.link
        navigate={~p"/pipeline/activity/#{@pipeline_name}"}
        class="text-[#2d6ca2] hover:underline"
      >
        {@pipeline_name}
      </.link>
      <span>/</span>
      <.link
        navigate={~p"/pipelines/value_stream_map/#{@pipeline_name}/#{@pipeline_counter}"}
        class="text-[#2d6ca2] hover:underline"
      >
        {@pipeline_counter}
      </.link>
      <span>/</span>
      <.link
        navigate={
          ~p"/pipelines/#{@pipeline_name}/#{@pipeline_counter}/#{@stage_name}/#{@stage_counter}"
        }
        class="text-[#2d6ca2] hover:underline"
      >
        {@stage_name}
      </.link>
      <span>/</span>
      <span>{@stage_counter}</span>
      <span>/</span>
      <span class="text-gray-800">{@job_name}</span>
    </div>

    <div class="flex items-center justify-between mt-2 flex-wrap gap-4">
      <div class="flex items-center gap-4">
        <h1 class="text-2xl font-extrabold text-gray-950 font-mono flex items-baseline gap-2">
          {@job_name}
          <span class="text-sm font-semibold text-gray-500">Job Run Details</span>
        </h1>
      </div>
    </div>
  </div>

  <%= if @job_instance do %>
    <div class="flex items-center gap-3 bg-white px-4 py-3 border border-gray-200 rounded shadow-sm text-sm font-mono mb-6">
      <span class="text-gray-400 font-bold uppercase tracking-wider text-[10px]">
        Job State
      </span>
      <span class="font-bold text-gray-800">{@job_instance.state}</span>
      <span class="text-gray-400 font-bold uppercase tracking-wider text-[10px] ml-2">
        Result
      </span>
      <span class={"font-bold px-2 py-0.5 rounded text-xs text-white " <>
        case @job_instance.result do
          "Passed" -> "bg-[#5cb85c]"
          "Failed" -> "bg-[#d9534f]"
          "Cancelled" -> "bg-[#f0ad4e]"
          _ -> "bg-blue-500"
        end}>
        {@job_instance.result || "Unknown"}
      </span>
      <%= if @agent do %>
        <span class="text-gray-400 font-bold uppercase tracking-wider text-[10px] ml-2">
          Agent
        </span>
        <.link
          navigate={~p"/agents/#{@agent.uuid}/job_run_history"}
          class="font-bold text-[#2d6ca2] hover:underline"
        >
          {@agent.hostname}
          <span class="text-gray-400 font-normal">
            ({String.slice(@agent.uuid, 0, 8)}...)
          </span>
        </.link>
        <% work_dir =
          build_working_dir(
            @agent,
            @pipeline_name,
            @pipeline_counter,
            @stage_name,
            @stage_counter,
            @job_name
          ) %>
        <%= if work_dir do %>
          <span class="text-gray-300 mx-1">|</span>
          <span
            class="text-gray-400 font-bold uppercase tracking-wider text-[10px]"
            title={"Working directory: #{work_dir}"}
          >
            Dir
          </span>
          <span
            class="font-mono text-[10px] text-gray-500 truncate max-w-[200px]"
            title={work_dir}
          >
            {Path.join([
              "…",
              "ex_gocd_jobs",
              @pipeline_name,
              to_string(@pipeline_counter),
              @stage_name,
              to_string(@stage_counter),
              @job_name
            ])}
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded shadow-sm overflow-hidden">
    <!-- Tab Controls -->
    <nav class="flex border-b border-gray-200 bg-gray-50 px-4" aria-label="Tabs">
      <button
        phx-click="select_tab"
        phx-value-tab="console"
        class={"px-4 py-3 text-xs font-bold font-mono tracking-wide border-b-2 " <>
          if @active_tab == "console", do: "border-[#2d6ca2] text-[#2d6ca2]", else: "border-transparent text-gray-500 hover:text-gray-700"}
      >
        <i class="fa fa-terminal mr-1.5 text-gray-400"></i> Console Log
      </button>
      <button
        phx-click="select_tab"
        phx-value-tab="tests"
        class={"px-4 py-3 text-xs font-bold font-mono tracking-wide border-b-2 " <>
          if @active_tab == "tests", do: "border-[#2d6ca2] text-[#2d6ca2]", else: "border-transparent text-gray-500 hover:text-gray-700"}
      >
        <i class="fa fa-flask mr-1.5 text-gray-400"></i> Tests
      </button>
      <button
        phx-click="select_tab"
        phx-value-tab="artifacts"
        class={"px-4 py-3 text-xs font-bold font-mono tracking-wide border-b-2 " <>
          if @active_tab == "artifacts", do: "border-[#2d6ca2] text-[#2d6ca2]", else: "border-transparent text-gray-500 hover:text-gray-700"}
      >
        <i class="fa fa-folder-open mr-1.5 text-gray-400"></i> Artifacts
      </button>
      <button
        phx-click="select_tab"
        phx-value-tab="materials"
        class={"px-4 py-3 text-xs font-bold font-mono tracking-wide border-b-2 " <>
          if @active_tab == "materials", do: "border-[#2d6ca2] text-[#2d6ca2]", else: "border-transparent text-gray-500 hover:text-gray-700"}
      >
        <i class="fa fa-code-branch mr-1.5 text-gray-400"></i> Materials
      </button>
      <button
        phx-click="select_tab"
        phx-value-tab="environment"
        class={"px-4 py-3 text-xs font-bold font-mono tracking-wide border-b-2 " <>
          if @active_tab == "environment", do: "border-[#2d6ca2] text-[#2d6ca2]", else: "border-transparent text-gray-500 hover:text-gray-700"}
      >
        <i class="fa fa-cog mr-1.5 text-gray-400"></i> Environment
      </button>
      <%= for {tab_name, tab_path} <- @custom_tabs do %>
        <button
          phx-click="select_tab"
          phx-value-tab={"custom:#{tab_name}"}
          class={"px-4 py-3 text-xs font-bold font-mono tracking-wide border-b-2 " <>
            if @active_tab == "custom:#{tab_name}", do: "border-[#2d6ca2] text-[#2d6ca2]", else: "border-transparent text-gray-500 hover:text-gray-700"}
        >
          <i class="fa fa-link mr-1.5 text-gray-400"></i> {tab_name}
        </button>
      <% end %>
    </nav>
    
<!-- Tab Contents -->
    <div class="p-6">
      <!-- Console Tab -->
      <div class={[@active_tab != "console" && "hidden"]}>
        <div class="flex items-center justify-between mb-2 px-1">
          <span class="text-[10px] text-gray-400 uppercase tracking-wider font-bold">
            Console Output
          </span>
          <div class="flex items-center gap-3 flex-wrap">
            <a
              href={
                ~p"/files/#{@pipeline_name}/#{@pipeline_counter}/#{@stage_name}/#{@stage_counter}/#{@job_name}/cruise-output/console.log"
              }
              class="text-[10px] text-[#2d6ca2] hover:underline font-bold uppercase tracking-wider"
            >
              Raw Output
            </a>
            <button
              class="text-[10px] text-gray-400 hover:text-gray-200 font-bold uppercase tracking-wider"
              onclick="var cl=this.closest('.p-6').querySelector('.console-log'); if(cl){cl.querySelectorAll('.fold-start').forEach(function(f){f.classList.remove('collapsed')})}; window.dispatchEvent(new CustomEvent('update-folds'))"
            >
              Expand All
            </button>
            <button
              class="text-[10px] text-gray-400 hover:text-gray-200 font-bold uppercase tracking-wider"
              onclick="var cl=this.closest('.p-6').querySelector('.console-log'); if(cl){cl.querySelectorAll('.fold-start').forEach(function(f){f.classList.add('collapsed')})}; window.dispatchEvent(new CustomEvent('update-folds'))"
            >
              Collapse All
            </button>
            <label class="flex items-center gap-1 text-[10px] text-gray-400 cursor-pointer select-none">
              <input
                type="checkbox"
                id="toggle-wrap"
                class="w-3 h-3"
                checked={@wrap_lines}
                onchange="var cl=document.getElementById('console-container'); cl.classList.toggle('no-wrap',!this.checked)"
                phx-change="toggle_wrap"
              /> Line Wrap
            </label>
            <input
              type="text"
              id="console-search"
              placeholder="Filter..."
              autocomplete="off"
              class="w-32 px-2 py-0.5 text-[10px] bg-gray-800 border border-gray-700 rounded text-gray-300 placeholder-gray-600 focus:outline-none focus:border-gray-500"
              oninput="var inp=this; clearTimeout(inp._debounce); inp._debounce=setTimeout(function(){var rows=document.getElementById('console-container').querySelectorAll('.log-row'); var parts=inp.value.toLowerCase().split(/\s+/).filter(function(p){return p.length>0}); rows.forEach(function(row){var msg=row.querySelector('.log-message'); if(!msg)return; var m=msg.textContent.toLowerCase(); row.classList.toggle('filter-hidden', parts.length>0 && !parts.every(function(p){return m.indexOf(p)!==-1}))})},150)"
            />
            <button
              class="text-[10px] text-gray-400 hover:text-gray-200 font-bold uppercase tracking-wider"
              onclick="var txt='';this.closest('.p-6').querySelectorAll('.log-row:not(.hidden):not(.filter-hidden)').forEach(function(r){var msg=r.querySelector('.log-message'); var ts=r.querySelector('.log-timestamp'); var t=''; if(msg)t=msg.textContent; if(ts && ts.offsetWidth>0){txt+='['+ts.textContent+'] '+t+'\n'}else{txt+=t+'\n'}});navigator.clipboard.writeText(txt);this.textContent='Copied!';setTimeout(function(b){b.textContent='Copy'},1500,this)"
            >
              Copy
            </button>
            <label class="flex items-center gap-1 text-[10px] text-gray-400 cursor-pointer select-none">
              <input
                type="checkbox"
                id="toggle-timestamps"
                class="w-3 h-3"
                checked={@show_timestamps}
                onchange="document.getElementById('console-container').classList.toggle('show-timestamps')"
                phx-change="toggle_timestamps"
              /> Timestamps
            </label>
            <label class="flex items-center gap-1 text-[10px] text-gray-400 cursor-pointer select-none">
              <input
                type="checkbox"
                id="toggle-follow"
                class="w-3 h-3"
                checked={@follow}
                onchange="document.getElementById('console-container').dataset.follow = this.checked"
                phx-change="toggle_follow"
              /> Follow
            </label>
          </div>
        </div>

        <div
          class={[
            "console-log bg-gray-950 rounded-lg p-6 font-mono text-gray-300 text-xs overflow-y-auto max-h-[600px] leading-relaxed shadow-inner border border-gray-900",
            @show_timestamps && "show-timestamps",
            !@wrap_lines && "no-wrap"
          ]}
          id="console-container"
          phx-hook="ConsoleScroller"
          data-follow={to_string(@follow)}
        >
          <%= if @line_count > 1000 do %>
            <div class="bg-yellow-900/40 border border-yellow-700/50 rounded px-3 py-2 mb-3 text-[10px] text-yellow-300 flex items-center gap-2">
              <i class="fa fa-exclamation-triangle"></i>
              <span>
                Showing the last 1,000 lines (total: {@line_count} lines).
                <a
                  href={
                    ~p"/files/#{@pipeline_name}/#{@pipeline_counter}/#{@stage_name}/#{@stage_counter}/#{@job_name}/cruise-output/console.log"
                  }
                  class="text-yellow-100 underline font-bold"
                >
                  Download Full Log
                </a>
              </span>
            </div>
          <% end %>
          <div
            id="log-lines-stream"
            class={[
              "select-text selection:bg-purple-900 selection:text-white",
              !@wrap_lines && "overflow-x-auto"
            ]}
            phx-update="stream"
          >
            <%!-- prettier-ignore --%>
            <%= for {dom_id, line} <- @streams.log_lines do %>
              <%= if line.type == :fold_start do %>
                <div
                  id={dom_id}
                  class="log-row fold-start flex items-start font-mono text-[11px] leading-5 cursor-pointer select-none hover:bg-gray-800/50"
                  data-fold-id={line.fold_id}
                  data-fold-parents={line.fold_parents}
                  onclick="var f=this.closest('.fold-start'); f.classList.toggle('collapsed'); window.dispatchEvent(new CustomEvent('update-folds'))"
                >
                  <span class="fold-chevron text-gray-500 mr-3 shrink-0 inline-block w-3">
                    <i class="fa fa-chevron-down text-[9px]"></i>
                  </span>
                  <span class="log-message text-gray-300 flex-1 font-bold whitespace-pre-wrap break-all">
                    <span class="msg-text">{line.fold_name}</span>
                  </span>
                </div>
              <% else %>
                <div
                  id={dom_id}
                  class={[
                    "log-row flex items-start font-mono text-[11px] leading-5",
                    line.type == :fold_end && "hidden"
                  ]}
                  data-fold-parents={line.fold_parents}
                  data-fold-end={to_string(line.type == :fold_end)}
                >
                  <%= if line.timestamp do %>
                    <span class="log-timestamp text-gray-500 select-none mr-3 shrink-0">
                      <span class="ts-text">{line.timestamp}</span>
                    </span>
                  <% end %>
                  <span class="log-message text-gray-300 flex-1 whitespace-pre-wrap break-all">
                    <span class="msg-text">{line.formatted_message}</span>
                  </span>
                </div>
              <% end %>
            <% end %>
          </div>

          <%= cond do %>
            <% @job_instance && @job_instance.state == "Completed" && @job_instance.result == "Passed" && @line_count == 0 -> %>
              <div class="text-green-500 py-8 text-center flex flex-col items-center justify-center gap-3">
                <i class="fa fa-check-circle text-2xl text-green-500"></i>
                <span class="font-bold">Job Passed</span>
                <p class="text-gray-500 text-[10px] mt-1 max-w-md">
                  Job completed successfully. No console output was captured.
                </p>
              </div>
            <% @job_instance && @job_instance.state == "Completed" && @job_instance.result == "Cancelled" && @line_count == 0 -> %>
              <div class="text-amber-500 py-8 text-center flex flex-col items-center justify-center gap-3">
                <i class="fa fa-ban text-2xl text-amber-500"></i>
                <span class="font-bold">Job Cancelled</span>
                <p class="text-gray-500 text-[10px] mt-1 max-w-md">
                  Job was cancelled before producing console output.
                </p>
              </div>
            <% is_nil(@run) || @run.state in ["Scheduled", "Assigned", "Preparing"] -> %>
              <div class="py-8 px-6 flex flex-col items-center gap-4">
                <div class="text-gray-500 italic text-center flex flex-col items-center justify-center gap-2">
                  <i class="fa fa-spinner animate-spin text-xl text-gray-600"></i>
                  <span>
                    Job is {(@run && @run.state) || "Scheduled"}. Waiting for agent to start...
                  </span>
                </div>
                <%= if @scheduling_diagnostics do %>
                  <div class="bg-amber-50 border border-amber-200 rounded-lg p-5 max-w-lg w-full text-left">
                    <div class="flex items-center gap-2 mb-3">
                      <i class="fa fa-search text-amber-600"></i>
                      <span class="text-xs font-bold text-amber-800 uppercase tracking-wider">
                        Why isn't this job running?
                      </span>
                    </div>
                    <div class="space-y-2 text-xs text-gray-700 font-mono">
                      <div>
                        <span class="text-gray-400">Required resources:</span>
                        <span class="font-bold text-amber-700 ml-1">
                          {Enum.join(@scheduling_diagnostics.required_resources, ", ")}
                        </span>
                      </div>
                      <div>
                        <span class="text-gray-400">Agents connected:</span>
                        <span class="font-bold ml-1">
                          <%= if @scheduling_diagnostics.any_agent_connected do %>
                            <span class="text-green-600">
                              {@scheduling_diagnostics.total_agents} agent(s)
                            </span>
                          <% else %>
                            <span class="text-red-500">None</span>
                          <% end %>
                        </span>
                      </div>
                      <div>
                        <span class="text-gray-400">Agents matching:</span>
                        <span class="font-bold ml-1">
                          <%= if @scheduling_diagnostics.matching_agents != [] do %>
                            <span class="text-green-600">
                              {length(@scheduling_diagnostics.matching_agents)} agent(s): {@scheduling_diagnostics.matching_agents
                              |> Enum.map(& &1.hostname)
                              |> Enum.join(", ")}
                            </span>
                          <% else %>
                            <span class="text-red-500">None</span>
                          <% end %>
                        </span>
                      </div>
                      <%= if @scheduling_diagnostics.non_matching_detail != [] do %>
                        <div class="mt-2 pt-2 border-t border-amber-200">
                          <span class="text-gray-400 block mb-1">Agents that don't match:</span>
                          <%= for item <- @scheduling_diagnostics.non_matching_detail do %>
                            <div class="ml-2 mb-1">
                              <span class="text-gray-600">
                                <i class="fa fa-desktop text-gray-400 mr-1"></i>
                                {item.hostname}
                              </span>
                              <span class="text-gray-400 ml-1">
                                has [{Enum.join(item.has, ", ")}],
                                missing [<span class="text-red-500 font-bold"><%= Enum.join(item.missing, ", ") %></span>]
                              </span>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                      <%= if !@scheduling_diagnostics.any_agent_connected do %>
                        <div class="mt-2 pt-2 border-t border-amber-200">
                          <span class="text-red-500 font-bold">
                            <i class="fa fa-exclamation-triangle mr-1"></i>
                            No agents are connected. Start agents with matching resources.
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% @run.state == "Building" && @line_count == 0 -> %>
              <div class="text-gray-500 italic py-8 text-center flex flex-col items-center justify-center gap-2">
                <i class="fa fa-spinner animate-spin text-xl text-gray-600"></i>
                <span>Job is building. Console output will appear here...</span>
              </div>
            <% @job_instance && @job_instance.result == "Failed" && @line_count == 0 -> %>
              <div class="text-red-400 py-8 text-center flex flex-col items-center justify-center gap-3">
                <i class="fa fa-times-circle text-2xl text-red-500"></i>
                <span class="font-bold">Job Failed</span>
                <span class="text-gray-500 text-[11px] max-w-sm">
                  {failure_reason(@job_instance)}
                </span>
                <p class="text-gray-600 text-[10px] mt-1 max-w-md">
                  No console output was captured. This could mean the job never started (no agent available, resource mismatch, or configuration error).
                </p>
              </div>
            <% @line_count == 0 -> %>
              <div class="text-gray-500 italic py-8 text-center flex flex-col items-center justify-center gap-2">
                <i class="fa fa-clock-o text-xl text-gray-600"></i>
                <span>No console output available for this job run.</span>
              </div>
            <% true -> %>
              <%!-- Hide empty status once lines are streaming --%>
          <% end %>
        </div>
      </div>
      
<!-- Tests Tab -->
      <div class={[@active_tab != "tests" && "hidden"]}>
        <div class="tests-container">
          <%= if @test_report do %>
            <% report = @test_report %>
            <!-- Summary Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
              <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-gray-800 font-mono">{report.total_tests}</div>
                <div class="text-[10px] text-gray-500 uppercase tracking-wider mt-1">Total</div>
              </div>
              <div class="bg-green-50 border border-green-200 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-green-700 font-mono">{report.passed}</div>
                <div class="text-[10px] text-green-600 uppercase tracking-wider mt-1">Passed</div>
              </div>
              <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-red-700 font-mono">{report.failed}</div>
                <div class="text-[10px] text-red-600 uppercase tracking-wider mt-1">Failed</div>
              </div>
              <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-amber-700 font-mono">{report.errored}</div>
                <div class="text-[10px] text-amber-600 uppercase tracking-wider mt-1">Errors</div>
              </div>
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-gray-500 font-mono">{report.skipped}</div>
                <div class="text-[10px] text-gray-400 uppercase tracking-wider mt-1">Skipped</div>
              </div>
              <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-gray-800 font-mono">
                  {format_test_time(report.total_time)}
                </div>
                <div class="text-[10px] text-gray-500 uppercase tracking-wider mt-1">
                  Duration
                </div>
              </div>
            </div>
            <!-- Progress Bar -->
            <div class="mb-6">
              <div class="flex h-6 rounded-full overflow-hidden border border-gray-200 bg-gray-100">
                <%= if report.total_tests > 0 do %>
                  <div
                    style={"width: #{test_bar_width(report.passed, report.total_tests)}"}
                    class="bg-green-500 transition-all"
                  >
                  </div>
                  <div
                    style={"width: #{test_bar_width(report.failed, report.total_tests)}"}
                    class="bg-red-500 transition-all"
                  >
                  </div>
                  <div
                    style={"width: #{test_bar_width(report.errored, report.total_tests)}"}
                    class="bg-amber-500 transition-all"
                  >
                  </div>
                  <div
                    style={"width: #{test_bar_width(report.skipped, report.total_tests)}"}
                    class="bg-gray-300 transition-all"
                  >
                  </div>
                <% end %>
              </div>
              <div class="flex text-[9px] text-gray-500 mt-1 px-1 gap-4 font-mono">
                <span>
                  <span class="inline-block w-2 h-2 bg-green-500 rounded-full mr-1"></span> {report.passed} passed
                </span>
                <span>
                  <span class="inline-block w-2 h-2 bg-red-500 rounded-full mr-1"></span> {report.failed} failed
                </span>
                <span>
                  <span class="inline-block w-2 h-2 bg-amber-500 rounded-full mr-1"></span> {report.errored} errors
                </span>
                <span>
                  <span class="inline-block w-2 h-2 bg-gray-300 rounded-full mr-1"></span> {report.skipped} skipped
                </span>
              </div>
            </div>
            <!-- Suite Tables -->
            <%= for suite <- report.suites do %>
              <div class="mb-4 border border-gray-200 rounded-lg overflow-hidden">
                <div class="bg-gray-50 px-4 py-3 flex items-center justify-between border-b border-gray-200">
                  <div>
                    <span class="font-bold text-gray-800 font-mono text-sm">{suite.name}</span>
                    <span class="text-xs text-gray-500 ml-3">
                      {suite.tests} tests, {suite.failures} failures, {suite.errors} errors, {suite.skipped} skipped
                    </span>
                  </div>
                  <span class="text-xs text-gray-400 font-mono">
                    {format_test_time(suite.time)}
                  </span>
                </div>
                <table class="min-w-full divide-y divide-gray-100 text-xs">
                  <thead>
                    <tr class="bg-gray-50 text-[10px] uppercase font-bold text-gray-400 tracking-wider font-mono">
                      <th class="px-4 py-2 text-left w-8"></th>
                      <th class="px-4 py-2 text-left">Test</th>
                      <th class="px-4 py-2 text-left hidden sm:table-cell">Class</th>
                      <th class="px-4 py-2 text-right w-16">Duration</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100 font-mono">
                    <%= for tc <- suite.cases do %>
                      <tr class={[
                        "hover:bg-gray-50/50",
                        tc.result == "failed" && "bg-red-50/30",
                        tc.result == "error" && "bg-amber-50/30",
                        tc.result == "skipped" && "bg-gray-50/50 text-gray-400"
                      ]}>
                        <td class="px-4 py-2">
                          <i class={[
                            "fa text-xs",
                            tc.result == "passed" && "fa-check text-green-500",
                            tc.result == "failed" && "fa-times text-red-500",
                            tc.result == "error" && "fa-exclamation-triangle text-amber-500",
                            tc.result == "skipped" && "fa-minus text-gray-300"
                          ]}>
                          </i>
                        </td>
                        <td class="px-4 py-2">
                          <span class={tc.result == "failed" && "text-red-700 font-bold"}>
                            {tc.name}
                          </span>
                          <%= if tc.message && tc.result in ["failed", "error"] do %>
                            <div
                              class="text-[10px] text-red-600 mt-0.5 max-w-lg truncate"
                              title={tc.message}
                            >
                              {tc.message}
                            </div>
                          <% end %>
                        </td>
                        <td class="px-4 py-2 text-gray-500 hidden sm:table-cell">
                          {tc.classname}
                        </td>
                        <td class="px-4 py-2 text-right text-gray-400">
                          {format_test_time(tc.time)}
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          <% else %>
            <div class="text-gray-500 italic py-12 text-center flex flex-col items-center justify-center gap-2 border border-dashed border-gray-200 rounded-lg bg-gray-50/50">
              <i class="fa fa-flask text-2xl text-gray-300"></i>
              <span>No test reports found for this job run.</span>
              <p class="text-xs text-gray-400 max-w-md mt-1">
                To generate test reports, configure your job to produce JUnit XML files
                and upload them as artifacts in a
                <code class="bg-gray-200 px-1 rounded">testoutput/</code>
                directory.
              </p>
            </div>
          <% end %>
        </div>
      </div>
      
<!-- Artifacts Tab -->
      <div class={[@active_tab != "artifacts" && "hidden"]}>
        <div class="artifacts-container">
          <%= if @job_instance && @job_instance.stage_instance && @job_instance.stage_instance.artifacts_deleted do %>
            <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-md text-xs font-mono flex items-start gap-2.5">
              <i class="fa fa-warning text-base mt-0.5 text-amber-500"></i>
              <div>
                <h4 class="font-bold">Artifacts Purged</h4>
                <p class="mt-1">
                  The artifacts for this stage run have been deleted by the artifact max storage cleanup policy to reclaim disk space.
                </p>
              </div>
            </div>
          <% else %>
            <%= if Enum.empty?(@artifacts) do %>
              <div class="text-gray-500 italic py-12 text-center flex flex-col items-center justify-center gap-2 border border-dashed border-gray-200 rounded-lg bg-gray-50/50">
                <i class="fa fa-folder text-2xl text-gray-300"></i>
                <span>No artifacts uploaded for this job run.</span>
              </div>
            <% else %>
              <div class="border border-gray-200 rounded overflow-hidden">
                <%= for item <- @artifacts do %>
                  {render_artifact_node(
                    Map.put(item, :pipeline_name, @pipeline_name)
                    |> Map.put(:pipeline_counter, @pipeline_counter)
                    |> Map.put(:stage_name, @stage_name)
                    |> Map.put(:stage_counter, @stage_counter)
                    |> Map.put(:job_name, @job_name)
                  )}
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      
<!-- Materials Tab -->
      <div class={[@active_tab != "materials" && "hidden"]}>
        <div class="materials-container">
          <%= if Enum.empty?(@materials) do %>
            <div class="text-gray-500 italic py-12 text-center flex flex-col items-center justify-center gap-2 border border-dashed border-gray-200 rounded-lg bg-gray-50/50">
              <i class="fa fa-code-branch text-2xl text-gray-300"></i>
              <span>No material revisions recorded for this job run.</span>
            </div>
          <% else %>
            <div class="border border-gray-200 rounded overflow-hidden">
              <table class="min-w-full divide-y divide-gray-200 text-xs text-left">
                <thead>
                  <tr class="bg-gray-50 text-[10px] uppercase font-bold text-gray-400 tracking-wider font-mono">
                    <th class="px-6 py-3">Material</th>
                    <th class="px-6 py-3">Type</th>
                    <th class="px-6 py-3">Revision</th>
                    <th class="px-6 py-3">Comment</th>
                    <th class="px-6 py-3">Modified</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-mono text-gray-700">
                  <%= for material <- @materials do %>
                    <tr class="hover:bg-gray-50/50">
                      <td class="px-6 py-3.5 font-bold text-gray-800">{material.name}</td>
                      <td class="px-6 py-3.5 text-gray-500">{material.type}</td>
                      <td
                        class="px-6 py-3.5 text-[11px] text-gray-600 font-mono"
                        title={material.full_revision}
                      >
                        {material.revision}
                      </td>
                      <td
                        class="px-6 py-3.5 text-[11px] text-gray-600 max-w-xs truncate"
                        title={material.comment}
                      >
                        {material.comment}
                      </td>
                      <td class="px-6 py-3.5 text-gray-500">{material.modified_at}</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
      <!-- Environment Tab -->
      <div class={[@active_tab != "environment" && "hidden"]}>
        <%= if @environment_variables == %{} do %>
          <div class="text-gray-500 italic py-12 text-center flex flex-col items-center justify-center gap-2 border border-dashed border-gray-200 rounded-lg bg-gray-50/50">
            <i class="fa fa-cog text-2xl text-gray-300"></i>
            <span>No environment variables recorded for this job run.</span>
            <span class="text-[10px] text-gray-400">
              Variables are stored when the build is assigned to an agent.
            </span>
          </div>
        <% else %>
          <div class="border border-gray-200 rounded overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200 text-xs text-left">
              <thead>
                <tr class="bg-gray-50 text-[10px] uppercase font-bold text-gray-400 tracking-wider font-mono">
                  <th class="px-6 py-3 w-1/3">Variable</th>
                  <th class="px-6 py-3">Value</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 font-mono text-gray-700">
                <%= for {name, value} <- Enum.sort(@environment_variables) do %>
                  <tr class="hover:bg-gray-50/50">
                    <td class="px-6 py-3.5 font-bold text-gray-800">{name}</td>
                    <td class="px-6 py-3.5 text-[11px] text-gray-600 break-all">
                      <%= if String.contains?(name, "PASSWORD") or String.contains?(name, "SECRET") or String.contains?(name, "TOKEN") do %>
                        <span class="text-gray-400 italic">********</span>
                      <% else %>
                        {value}
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
      
<!-- Custom Tabs -->
      <%= for {tab_name, tab_path} <- @custom_tabs do %>
        <div class={[@active_tab != "custom:#{tab_name}" && "hidden"]}>
          <div class="text-gray-500 py-12 text-center flex flex-col items-center justify-center gap-2 border border-dashed border-gray-200 rounded-lg bg-gray-50/50">
            <i class="fa fa-external-link text-2xl text-gray-300"></i>
            <span>Custom tab: <strong class="text-gray-700">{tab_name}</strong></span>
            <a
              href={"/files/#{@pipeline_name}/#{@pipeline_counter}/#{@stage_name}/#{@stage_counter}/#{@job_name}/#{tab_path}"}
              class="text-[#2d6ca2] hover:underline font-bold text-xs mt-1"
            >
              <i class="fa fa-external-link mr-1"></i>
              Open {tab_path |> String.split("/") |> List.last()}
            </a>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
